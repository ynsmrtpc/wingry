<Page
    x:Class="Wingry.Pages.BloatwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Wingry.Services">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Gereksiz uygulamalar" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="Windows ve bilgisayar üreticisiyle birlikte gelen, çoğu kişinin kullanmadığı Store uygulamaları. Yalnızca bu bilgisayarda yüklü olanlar listelenir; kaldırılanları Microsoft Store'dan yeniden kurabilirsiniz." />

        <Grid Grid.Row="2" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Önerilenleri seç" Click="OnSelectRecommended" />
                <Button Content="Hiçbirini seçme" Click="OnSelectNone" />
                <TextBlock x:Name="Summary" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Caption}" />
            </StackPanel>
            <Button x:Name="RemoveBtn" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnRemove">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="Ring" Width="16" Height="16" IsActive="False" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock x:Name="RemoveText" Text="Seçilenleri kaldır" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
            <Grid>
                <ListView x:Name="List" SelectionMode="None" ItemContainerStyle="{StaticResource DenseListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:BloatApp">
                            <Grid Padding="0,8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <CheckBox MinWidth="0" IsChecked="{x:Bind Selected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FriendlyName}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{x:Bind Status, Mode=OneWay}" />
                                <Border Grid.Column="3" Padding="8,2,8,3" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock FontSize="11" Text="{x:Bind RecommendationText}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="LoadingRing" IsActive="True" />
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <FontIcon FontSize="40" Glyph="&#xE73E;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Temiz" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Listedeki gereksiz uygulamaların hiçbiri bu bilgisayarda yüklü değil." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
