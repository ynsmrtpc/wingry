<Page
    x:Class="Wingry.Pages.OperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Wingry.Services">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="İşlemler" />
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0" Text="Kurulum, güncelleme ve kaldırma işlemleri sırayla çalışır. Sayfadan ayrılabilirsiniz; işlemler sürer." />
            <Button HorizontalAlignment="Right" Content="Bitenleri temizle" Click="OnClear" />
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
            <Grid>
                <ListView x:Name="List" SelectionMode="None" ItemContainerStyle="{StaticResource DenseListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:OpItem">
                            <Grid Padding="0,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="18" Glyph="{x:Bind StateGlyph, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind KindText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Stage, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Maximum="100" Value="{x:Bind Percent, Mode=OneWay}" IsIndeterminate="{x:Bind Indeterminate, Mode=OneWay}" Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="İptal" Tag="{x:Bind}" Click="OnCancel" Visibility="{x:Bind CanCancel, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="40" Glyph="&#xE896;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="İşlem yok" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Uygulamalar sayfasından kurulum ya da güncelleme başlatın." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
