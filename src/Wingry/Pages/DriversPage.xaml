<Page
    x:Class="Wingry.Pages.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wingry.Pages"
    NavigationCacheMode="Required">

    <Grid MaxWidth="1280" Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Sürücüler" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="Donanım sürücüleri. Windows'u yeniden kurmadan önce üçüncü taraf sürücüleri yedekleyin; yeni kurulumda Aygıt Yöneticisi'nden o klasörü göstererek geri yükleyebilirsiniz. Sürücü güncellemeleri Windows Update'in isteğe bağlı güncellemelerinden gelir." />

        <Grid Grid.Row="2" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Query" VerticalAlignment="Center" PlaceholderText="Aygıt, üretici ya da sınıf ara" QueryIcon="Find" TextChanged="OnQuery" />
            <ComboBox x:Name="Filter" Grid.Column="1" MinWidth="190" VerticalAlignment="Center" SelectedIndex="1" SelectionChanged="OnFilter">
                <x:String>Tüm sürücüler</x:String>
                <x:String>Microsoft dışı</x:String>
                <x:String>3 yıldan eski</x:String>
            </ComboBox>
            <TextBlock x:Name="Summary" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <Button Grid.Column="3" Click="OnUpdates" AutomationProperties.Name="Sürücü güncellemeleri">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE895;" /><TextBlock Text="Sürücü güncellemeleri" /></StackPanel>
            </Button>
            <Button x:Name="BackupBtn" Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="OnBackup" AutomationProperties.Name="Sürücüleri yedekle">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="BackupRing" Width="16" Height="16" IsActive="False" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock Text="Yedekle…" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
            <Grid>
                <ListView x:Name="List" SelectionMode="None" ItemContainerStyle="{StaticResource DenseListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DriverRow">
                            <Grid Padding="0,8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Device}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Sub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}" Text="Sürüm" />
                                    <TextBlock Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}" Text="Tarih" />
                                    <TextBlock Text="{x:Bind DateText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="LoadingRing" IsActive="True" />
            </Grid>
        </Border>
    </Grid>
</Page>
