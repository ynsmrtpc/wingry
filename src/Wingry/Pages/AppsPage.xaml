<Page
    x:Class="Wingry.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wingry.Pages"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="PackageTemplate" x:DataType="local:PackageRow">
            <Grid Padding="0,8" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind AvatarOpacity}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="{x:Bind Initial}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind VersionLabel}" />
                    <TextBlock Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Visibility="{x:Bind HasAvailable}">
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind AvailableLabel}" />
                    <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind Available}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="4" Padding="8,2,8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind HasSource}">
                    <TextBlock FontSize="11" Text="{x:Bind Source}" />
                </Border>
                <Button Grid.Column="5" Padding="6" Background="Transparent" BorderThickness="0" Tag="{x:Bind}" Click="OnRowMenu" ToolTipService.ToolTip="Diğer işlemler">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid MaxWidth="1280" Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="Uygulamalar" />

        <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="-12,4,0,8" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="TabInstalled" Tag="installed" Text="Yüklü" IsSelected="True">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE71D;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabUpdates" Tag="updates" Text="Güncellemeler">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE895;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabDiscover" Tag="discover" Text="Keşfet">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE721;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabBundles" Tag="bundles" Text="Hazır paketler">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE7B8;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- Araç çubuğu -->
        <Grid x:Name="Toolbar" Grid.Row="2" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Query" VerticalAlignment="Center" PlaceholderText="Listede ara" QueryIcon="Find" TextChanged="OnQueryChanged" QuerySubmitted="OnQuerySubmitted" />
            <ComboBox x:Name="Sort" Grid.Column="1" VerticalAlignment="Center" MinWidth="150" SelectedIndex="0" SelectionChanged="OnSortChanged">
                <x:String>Ada göre</x:String>
                <x:String>Yayımcıya göre</x:String>
                <x:String>Kaynağa göre</x:String>
            </ComboBox>
            <CommandBar Grid.Column="3" DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="BtnInstall" Label="Kur" Click="OnInstall" Visibility="Collapsed">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="BtnUpdate" Label="Güncelle" Click="OnUpdate">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="BtnUpdateAll" Label="Tümünü güncelle" Click="OnUpdateAll" Visibility="Collapsed">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B3;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="BtnIgnore" Label="Yoksay" Click="OnIgnore" Visibility="Collapsed">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7BA;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="BtnUninstall" Label="Kaldır" Click="OnUninstall">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="BtnMakeBundle" Label="Paket oluştur" Click="OnMakeBundle" ToolTipService.ToolTip="Seçili uygulamalardan hazır paket oluştur">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="BtnRefresh" Label="Yenile" Click="OnRefresh">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Liste -->
        <Grid x:Name="ListArea" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="2,0,2,6">
                <CheckBox x:Name="SelectAll" Content="Tümünü seç" Checked="OnSelectAll" Unchecked="OnSelectAll" MinWidth="0" />
                <TextBlock x:Name="Status" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
                <Grid>
                    <ListView
                        x:Name="List"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource DenseListItem}"
                        ItemTemplate="{StaticResource PackageTemplate}"
                        SelectionChanged="OnListSelection"
                        SelectionMode="Multiple" />
                    <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <FontIcon x:Name="EmptyIcon" FontSize="40" Glyph="&#xE73E;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="420" />
                    </StackPanel>
                    <StackPanel x:Name="Busy" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <ProgressRing IsActive="True" />
                        <TextBlock x:Name="BusyText" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Hazır paketler -->
        <ScrollViewer x:Name="BundleArea" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed">
            <StackPanel Padding="0,0,0,24" Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0" VerticalAlignment="Center" Text="Bir paket seçin, kurmak istemediklerinizin işaretini kaldırın. Zaten yüklü olanlar atlanır." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="OnNewBundle" AutomationProperties.Name="Yeni paket">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE710;" /><TextBlock Text="Yeni paket" /></StackPanel>
                        </Button>
                        <Button Click="OnImportBundle" AutomationProperties.Name="İçe aktar">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE8B5;" /><TextBlock Text="İçe aktar" /></StackPanel>
                        </Button>
                        <Button Click="OnOpenSharedFolder" AutomationProperties.Name="Paket klasörü" ToolTipService.ToolTip="Bu klasöre atılan paket dosyaları kendiliğinden listelenir">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE8DA;" /><TextBlock Text="Paket klasörü" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="SharedInfo" IsOpen="True" IsClosable="True" Severity="Informational" Title="Paylaşılan paketler" />
                <Grid x:Name="BundleList" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="BundleCol0" Spacing="12" />
                    <StackPanel x:Name="BundleCol1" Grid.Column="1" Spacing="12" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
