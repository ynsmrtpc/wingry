<Page
    x:Class="Wingry.Pages.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wingry.Pages"
    xmlns:svc="using:Wingry.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="FileTemplate" x:DataType="local:FileRow">
            <Grid Padding="0,6" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="18" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Folder}" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{x:Bind Kind}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{x:Bind Modified}" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind Size}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DirTemplate" x:DataType="local:DirRow">
            <Grid Padding="0,6" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="18" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Detail}" />
                </StackPanel>
                <ProgressBar Grid.Column="2" VerticalAlignment="Center" Maximum="100" Value="{x:Bind Percent}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind Size}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid MaxWidth="1280" Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Disk alanı" />
        <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="-12,4,0,8" SelectionChanged="OnTabChanged">
            <SelectorBarItem Tag="analyze" Text="Analiz" IsSelected="True">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE9F9;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Tag="cleanup" Text="Temizlik">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xEA99;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Tag="dups" Text="Kopyalar">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE8C8;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- ===================== ANALİZ ===================== -->
        <Grid x:Name="AnalyzeArea" Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sürücüler -->
            <ItemsRepeater x:Name="Drives">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="250" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="4" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!-- Tarama durumu -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ScanTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Taramak için bir sürücü ya da klasör seçin" />
                    <TextBlock x:Name="ScanDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ScanBar" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="PickBtn" Grid.Column="1" Click="OnPickFolder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8DA;" />
                        <TextBlock Text="Klasör tara…" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelBtn" Grid.Column="2" Content="Durdur" Click="OnCancelScan" Visibility="Collapsed" />
            </Grid>

            <!-- Görünüm + filtreler -->
            <Grid x:Name="FilterBar" Grid.Row="2" ColumnSpacing="8" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="ViewMode" Margin="-12,0,0,0" SelectionChanged="OnViewMode">
                    <SelectorBarItem Tag="0" Text="En büyük dosyalar" IsSelected="True">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE8A5;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Tag="1" Text="Klasörler">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE8B7;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Tag="2" Text="Türler">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE9D2;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
                <CommandBar Grid.Column="1" HorizontalAlignment="Right" DefaultLabelPosition="Right" Background="Transparent">
                    <AppBarButton x:Name="BtnReveal" Label="Konumu aç" Click="OnReveal">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="BtnRecycle" Label="Geri Dönüşüm Kutusu'na taşı" Click="OnRecycle">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <StackPanel x:Name="FileFilters" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="FName" Width="220" PlaceholderText="Ad veya uzantı (.mp4)" TextChanged="OnFilterChanged" />
                    <ComboBox x:Name="FKind" Width="150" SelectedIndex="0" SelectionChanged="OnFilterChanged" />
                    <ComboBox x:Name="FSize" Width="140" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <x:String>Her boyut</x:String>
                        <x:String>1 MB üstü</x:String>
                        <x:String>10 MB üstü</x:String>
                        <x:String>100 MB üstü</x:String>
                        <x:String>1 GB üstü</x:String>
                    </ComboBox>
                    <ComboBox x:Name="FAge" Width="170" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <x:String>Her tarih</x:String>
                        <x:String>30 günden eski</x:String>
                        <x:String>6 aydan eski</x:String>
                        <x:String>1 yıldan eski</x:String>
                        <x:String>2 yıldan eski</x:String>
                        <x:String>Son 7 gün</x:String>
                    </ComboBox>
                    <ComboBox x:Name="FSort" Width="190" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <x:String>Büyükten küçüğe</x:String>
                        <x:String>Küçükten büyüğe</x:String>
                        <x:String>En yeni</x:String>
                        <x:String>En eski</x:String>
                        <x:String>Ada göre</x:String>
                    </ComboBox>
                </StackPanel>
                <BreadcrumbBar x:Name="Crumbs" Grid.Row="1" Grid.ColumnSpan="2" ItemClicked="OnCrumb" Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="FileList" ItemTemplate="{StaticResource FileTemplate}" ItemContainerStyle="{StaticResource DenseListItem}"
                              SelectionMode="Extended" SelectionChanged="OnFileSelection" DoubleTapped="OnFileDoubleTapped" />
                    <ListView x:Name="DirList" ItemTemplate="{StaticResource DirTemplate}" ItemContainerStyle="{StaticResource DenseListItem}"
                              SelectionMode="Extended" IsItemClickEnabled="True" ItemClick="OnDirClick" SelectionChanged="OnFileSelection" Visibility="Collapsed" />
                    <ListView x:Name="KindList" ItemTemplate="{StaticResource DirTemplate}" ItemContainerStyle="{StaticResource DenseListItem}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnKindClick" Visibility="Collapsed" />
                    <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <FontIcon FontSize="40" Glyph="&#xEDA2;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Henüz tarama yapılmadı" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="440"
                                   Text="Bir sürücünün altındaki Tara düğmesine basın. Tüm dosyalar büyükten küçüğe sıralanır; türe, boyuta ve tarihe göre süzebilirsiniz." />
                    </StackPanel>
                    <TextBlock x:Name="ListFooter" Grid.Row="1" Margin="12,6" Style="{StaticResource Caption}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== KOPYALAR ===================== -->
        <Grid x:Name="DupArea" Grid.Row="2" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0" Text="Son disk taramasındaki dosyalar arasında içeriği birebir aynı olanları bulur (boyut + SHA-256). Hiçbir dosya kendiliğinden seçilmez: silmek istediklerinizi işaretleyin ya da 'Önerileni seç' ile her gruptan en eskisi dışındakileri seçin. Proje klasörlerindeki (node_modules, build) kopyalar projenin parçası olabilir. Taşıma Geri Dönüşüm Kutusu'na yapılır." />
            <StackPanel Grid.Row="1" Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DupMin" MinWidth="140" SelectedIndex="1" VerticalAlignment="Center" AutomationProperties.Name="En küçük dosya boyutu">
                        <x:String>100 KB üstü</x:String>
                        <x:String>1 MB üstü</x:String>
                        <x:String>10 MB üstü</x:String>
                        <x:String>100 MB üstü</x:String>
                    </ComboBox>
                    <Button x:Name="DupBtn" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="Kopyaları bul" Click="OnFindDups" />
                    <CheckBox x:Name="DupSystem" Grid.Column="2" Content="Sistem ve program klasörleri dahil" MinWidth="0" ToolTipService.ToolTip="Windows, Program Files, ProgramData ve AppData. Oradaki kopyaları silmek programları bozabilir." />
                    <Button x:Name="DupSuggest" Grid.Column="4" Content="Önerileni seç" Click="OnSuggestDups" IsEnabled="False" ToolTipService.ToolTip="Her gruptan en eski dosya dışındakileri işaretler" />
                    <Button x:Name="DupRecycle" Grid.Column="5" Content="Seçilenleri taşı" ToolTipService.ToolTip="Seçili kopyaları Geri Dönüşüm Kutusu'na taşır" Click="OnRecycleDups" IsEnabled="False" />
                </Grid>
                <TextBlock x:Name="DupStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <ProgressBar x:Name="DupBar" Visibility="Collapsed" Maximum="1" />
            </StackPanel>
            <ScrollViewer Grid.Row="2">
                <StackPanel x:Name="DupList" Spacing="8" Padding="0,0,0,24" />
            </ScrollViewer>
        </Grid>

        <!-- ===================== TEMİZLİK ===================== -->
        <ScrollViewer x:Name="CleanupArea" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Padding="0,0,0,24" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Yalnızca güvenle silinebilecek önbellek ve geçici konumlar temizlenir. Son 24 saatte değişmiş dosyalara dokunulmaz; kullanımdaki dosyalar atlanır." />
                <ItemsRepeater x:Name="CleanList">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="svc:CleanupTarget">
                            <tk:SettingsCard Header="{x:Bind Title}" Description="{x:Bind Description}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="{x:Bind Glyph}" /></tk:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <FontIcon FontSize="12" Glyph="&#xEA18;" Visibility="{x:Bind NeedsAdmin}" ToolTipService.ToolTip="Yönetici izni ister" />
                                    <TextBlock MinWidth="90" VerticalAlignment="Center" TextAlignment="Right" Text="{x:Bind SizeText, Mode=OneWay}" />
                                    <CheckBox MinWidth="0" IsChecked="{x:Bind Selected, Mode=TwoWay}" />
                                </StackPanel>
                            </tk:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CleanBtn" Style="{StaticResource AccentButtonStyle}" Click="OnClean">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CleanRing" Width="16" Height="16" IsActive="False" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock x:Name="CleanBtnText" Text="Seçilenleri temizle" />
                        </StackPanel>
                    </Button>
                    <Button Content="Yeniden hesapla" Click="OnMeasure" />
                    <TextBlock x:Name="CleanTotal" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
