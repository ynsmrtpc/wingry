<Page
    x:Class="Wingry.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Wingry.Services"
    NavigationCacheMode="Required">

    <Grid MaxWidth="1280" Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Hizmetler" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="Arka planda çalışan Windows ve uygulama hizmetleri. Değişiklikler yönetici izni ister. Windows'un çalışması için gereken hizmetler kalkan simgesiyle işaretli ve korunur." />

        <Grid Grid.Row="2" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Query" VerticalAlignment="Center" PlaceholderText="Ad, açıklama ya da yayımcı ara" QueryIcon="Find" TextChanged="OnQuery" />
            <ComboBox x:Name="Filter" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="OnFilter">
                <x:String>Tüm hizmetler</x:String>
                <x:String>Çalışanlar</x:String>
                <x:String>Durmuş olanlar</x:String>
                <x:String>Otomatik başlayanlar</x:String>
                <x:String>Devre dışı olanlar</x:String>
                <x:String>Microsoft dışı</x:String>
            </ComboBox>
            <TextBlock x:Name="Summary" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <Button Grid.Column="3" Click="OnRefresh" AutomationProperties.Name="Yenile">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE72C;" /><TextBlock Text="Yenile" /></StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
            <Grid>
                <ListView x:Name="List" SelectionMode="None" ItemContainerStyle="{StaticResource DenseListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:HizmetItem">
                            <Grid Padding="0,8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Description}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon FontSize="11" Glyph="&#xEA18;" Visibility="{x:Bind IsCritical}" ToolTipService.ToolTip="Windows için gerekli; durdurulamaz" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Description}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Opacity="0.7" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind Name}" /><Run Text="  ·  " /><Run Text="{x:Bind Publisher}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind Running}" />
                                    <TextBlock Text="{x:Bind StatusText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{x:Bind StartTypeText}" />
                                <Button Grid.Column="3" Padding="6" Background="Transparent" BorderThickness="0" Tag="{x:Bind}" Click="OnMenu" ToolTipService.ToolTip="Hizmet işlemleri" AutomationProperties.Name="Hizmet işlemleri">
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="LoadingRing" IsActive="True" />
            </Grid>
        </Border>
    </Grid>
</Page>
