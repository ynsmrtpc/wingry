<Page
    x:Class="Wingry.Pages.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Wingry.Controls"
    xmlns:svc="using:Wingry.Services"
    xmlns:local="using:Wingry.Pages"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Bellek (RAM)" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Arka plandaki uygulamaların ayırıp kullanmadığı belleği geri kazanın. Windows boş belleği önbellek olarak kullanır; temizlik ağır bir iş öncesinde ya da bellek sıkıştığında işe yarar." />

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="150" Height="150">
                        <ProgressRing x:Name="Ring" Width="150" Height="150" IsIndeterminate="False" Maximum="100" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="RingValue" HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold" Text="—" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="kullanımda" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" ColumnSpacing="24" RowSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource Caption}" Text="Toplam" /><TextBlock x:Name="VTotal" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="Kullanılan" /><TextBlock x:Name="VUsed" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="Kullanılabilir" /><TextBlock x:Name="VAvail" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                        <StackPanel Grid.Row="1"><TextBlock Style="{StaticResource Caption}" Text="Önbellek (bekleme listesi)" /><TextBlock x:Name="VStandby" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="Değiştirilmiş" /><TextBlock x:Name="VModified" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Style="{StaticResource Caption}" Text="Kaydedilen (commit)" /><TextBlock x:Name="VCommit" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                        <ctl:Sparkline x:Name="Spark" Grid.Row="2" Grid.ColumnSpan="3" Height="56" Capacity="120" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Bellek nereye gidiyor: gerçek kullanım / geri verilebilir önbellek / boş -->
            <Border x:Name="BreakdownCard" Margin="0,12,0,0" Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Bellek nereye gidiyor?" />
                    <Grid x:Name="Bar" Height="14" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColUsed" Width="1*" />
                            <ColumnDefinition x:Name="ColCache" Width="0*" />
                            <ColumnDefinition x:Name="ColFree" Width="0*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.4" />
                    </Grid>
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Style="{StaticResource Caption}" Text="Uygulamaların kullandığı" />
                            </StackPanel>
                            <TextBlock x:Name="BUsed" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Açık programların gerçekten tuttuğu bellek. Temizlik bunu geçici olarak düşürür; programlar çalıştıkça geri alır." />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.4" />
                                <TextBlock Style="{StaticResource Caption}" Text="Önbellek (geri verilebilir)" />
                            </StackPanel>
                            <TextBlock x:Name="BCache" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Windows'un hız için tuttuğu dosya ve program kopyaları. Bir program belleğe ihtiyaç duyduğu an anında boşaltılır; kullanılabilir sayılır." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                <TextBlock Style="{StaticResource Caption}" Text="Boş" />
                            </StackPanel>
                            <TextBlock x:Name="BFree" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Hiç kullanılmayan bellek. Windows bunu zamanla önbelleğe çevirir; boş belleğin az olması sorun değildir." />
                        </StackPanel>
                    </Grid>
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="Temizlikten sonra neden yine doluyor?"
                        Message="Temizlik belleği silmez; programların elinden alır. Programlar o sayfalara döndükçe geri alınır, Windows da boşalan alanı yeniden önbellek olarak doldurur. Bu normaldir. Önemli olan 'Kullanılabilir' miktar: önbellek de ona dahildir. Temizliği ağır bir işten (oyun, sanal makine, büyük derleme) önce ya da bellek gerçekten tıkandığında kullanın; çok sık temizlik bilgisayarı yavaşlatır." />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="QuickBtn" Style="{StaticResource AccentButtonStyle}" Click="OnQuick" MinWidth="160">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE945;" />
                        <TextBlock Text="Hızlı temizle" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeepBtn" Click="OnDeep" MinWidth="160" ToolTipService.ToolTip="Tüm süreçler + bekleme listesi + dosya önbelleği. Yönetici izni ister.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xEA18;" />
                        <TextBlock Text="Derin temizle" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="CleanRing" Width="22" Height="22" IsActive="False" />
                <TextBlock x:Name="LastResult" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Otomatik temizlik" />
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="Bellek dolunca temizle" Description="Wingry açıkken kullanım eşiği aştığında hızlı temizlik yapılır (en sık 5 dakikada bir).">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="Threshold" MinWidth="110" SelectionChanged="OnThreshold">
                            <x:String>%70</x:String>
                            <x:String>%75</x:String>
                            <x:String>%80</x:String>
                            <x:String>%85</x:String>
                            <x:String>%90</x:String>
                            <x:String>%95</x:String>
                        </ComboBox>
                        <ToggleSwitch x:Name="AutoToggle" OnContent="Açık" OffContent="Kapalı" Toggled="OnAutoToggle" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Zamanlanmış temizlik" Description="Wingry kapalıyken de belirli aralıklarla temizlik yapan bir Windows görevi oluşturun." IsClickEnabled="True" Click="OnSchedule">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;" /></tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="En çok bellek kullananlar" />
            <Border Style="{StaticResource Card}" Padding="16,8">
                <ItemsRepeater x:Name="Procs">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:ProcRow">
                            <Grid Padding="0,6" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Maximum="100" Value="{x:Bind Percent}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{x:Bind Size}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
