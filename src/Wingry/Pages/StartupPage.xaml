<Page
    x:Class="Wingry.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Wingry.Services">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Başlangıç uygulamaları" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="Windows açılırken kendiliğinden başlayan programlar. Kapatmak programı silmez, yalnızca açılışta başlamasını engeller; Görev Yöneticisi ile aynı ayardır, istediğiniz zaman geri açabilirsiniz." />

        <Grid Grid.Row="2" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Query" VerticalAlignment="Center" PlaceholderText="Ara" QueryIcon="Find" TextChanged="OnQuery" />
            <TextBlock x:Name="Summary" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <Button Grid.Column="2" Click="OnRefresh" AutomationProperties.Name="Yenile">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE72C;" /><TextBlock Text="Yenile" /></StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
            <Grid>
                <ListView x:Name="List" SelectionMode="None" ItemContainerStyle="{StaticResource DenseListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:StartupItem">
                            <Grid Padding="0,8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon FontSize="11" Glyph="&#xEA18;" Visibility="{x:Bind NeedsAdmin}" ToolTipService.ToolTip="Tüm kullanıcılar için; değiştirmek yönetici izni ister" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind Sub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Opacity="0.7" Text="{x:Bind Command}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Command}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" MinWidth="0" IsOn="{x:Bind Enabled, Mode=OneWay}" OnContent="Açık" OffContent="Kapalı" Tag="{x:Bind}" Toggled="OnToggled" AutomationProperties.Name="{x:Bind Name}" />
                                <Button Grid.Column="2" Padding="6" Background="Transparent" BorderThickness="0" Tag="{x:Bind}" Click="OnReveal" ToolTipService.ToolTip="Dosya konumunu aç" AutomationProperties.Name="Dosya konumunu aç">
                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="LoadingRing" IsActive="True" />
            </Grid>
        </Border>
    </Grid>
</Page>
