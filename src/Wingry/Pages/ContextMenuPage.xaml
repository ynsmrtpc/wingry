<Page
    x:Class="Wingry.Pages.ContextMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Wingry.Services">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Bağlam menüsü" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="Sağ tık menüsünü dolduran program girdileri. Kapatmak girdiyi gizler, programı etkilemez ve her zaman geri açılabilir. Windows 11'de çoğu girdi 'Diğer seçenekleri göster' altında görünür. Değişikliklerin görünmesi için Gezgin'i yeniden başlatmak gerekebilir." />

        <Grid Grid.Row="2" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Query" VerticalAlignment="Center" PlaceholderText="Ara" QueryIcon="Find" TextChanged="OnQuery" />
            <ComboBox x:Name="ScopeFilter" Grid.Column="1" MinWidth="190" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="OnFilter">
                <x:String>Tüm yerler</x:String>
                <x:String>Dosyalar</x:String>
                <x:String>Dosya ve klasörler</x:String>
                <x:String>Klasörler</x:String>
                <x:String>Klasör arka planı</x:String>
                <x:String>Sürücüler</x:String>
            </ComboBox>
            <TextBlock x:Name="Summary" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <Button Grid.Column="3" Click="OnRestartExplorer" AutomationProperties.Name="Gezgini yeniden başlat">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE72C;" /><TextBlock Text="Gezgini yeniden başlat" /></StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,24">
            <Grid>
                <ListView x:Name="List" SelectionMode="None" ItemContainerStyle="{StaticResource DenseListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:ContextEntry">
                            <Grid Padding="0,8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Opacity="0.7" Text="{x:Bind Detail}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Detail}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{x:Bind ScopeText}" />
                                <ToggleSwitch Grid.Column="2" MinWidth="0" IsOn="{x:Bind Enabled, Mode=OneWay}" IsEnabled="{x:Bind CanToggle}" OnContent="Görünür" OffContent="Gizli" Tag="{x:Bind}" Toggled="OnToggled" AutomationProperties.Name="{x:Bind Name}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="LoadingRing" IsActive="True" />
            </Grid>
        </Border>
    </Grid>
</Page>
