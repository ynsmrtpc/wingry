<Page
    x:Class="Wingry.Pages.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <Button
                        x:Name="RecommendButton"
                        Margin="0,28,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="OnRecommend"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE734;" />
                            <TextBlock Text="Önerilenleri işaretle" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar
                    x:Name="AdminInfo"
                    Margin="0,0,0,12"
                    IsClosable="True"
                    Severity="Informational"
                    Title="Bazı ayarlar sistem geneli"
                    Message="Kalkan simgeli ayarlar yönetici izni ister. Uygula'ya bastığınızda tek bir kez izin sorulur." />

                <ProgressRing x:Name="LoadingRing" Margin="0,40" IsActive="True" />
                <StackPanel x:Name="Items" Spacing="{StaticResource SettingsCardSpacing}" />

                <TextBlock
                    Margin="0,28,0,0"
                    Style="{StaticResource Caption}"
                    Text="Ayar tanımları Win11Debloat (Raphire, MIT lisansı) projesinden alınmıştır. Her uygulamada değişen değerler Ayarlar &gt; Yedekler altına kaydedilir." />
            </StackPanel>
        </ScrollViewer>

        <!-- Bekleyen değişiklikler çubuğu -->
        <Border
            x:Name="PendingBar"
            Grid.Row="1"
            Padding="24,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <Grid MaxWidth="{StaticResource PageMaxWidth}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PendingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="PendingDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <CheckBox x:Name="RestorePoint" Grid.Column="1" Content="Önce geri yükleme noktası oluştur" />
                <Button Grid.Column="2" Content="Vazgeç" Click="OnDiscard" />
                <Button x:Name="ApplyButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnApply">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="ApplyRing" Width="16" Height="16" IsActive="False" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Uygula" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
